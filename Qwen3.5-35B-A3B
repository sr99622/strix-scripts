#!/usr/bin/env fish

argparse 'port=' 'ctx-size=' -- $argv
or exit 1

set -l port 8033
if set -q _flag_port
    set port $_flag_port
end

set -l ctx_size 262144
if set -q _flag_ctx_size
    set ctx_size $_flag_ctx_size
end

set -lx LLAMA_CACHE "$HOME/Projects/llama.cpp/unsloth/Qwen3.5-35B-A3B-GGUF"

"$HOME/Projects/llama.cpp/build/bin/llama-server" \
    -hf unsloth/Qwen3.5-35B-A3B-GGUF:UD-Q4_K_XL \
    --ctx-size "$ctx_size" \
    --temp 1.0 \
    --top-p 0.95 \
    --top-k 20 \
    --min-p 0.00 \
    --host 0.0.0.0 --port "$port" \
    --alias "Qwen3.5-35B-A3B" --jinja
