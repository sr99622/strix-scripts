#!/usr/bin/env fish

argparse 'port=' 'ctx-size=' -- $argv
or exit 1

set -l port 8033
if set -q _flag_port
    set port $_flag_port
end

set -l ctx_size 262144
if set -q _flag_ctx_size
    set ctx_size $_flag_ctx_size
end

set -lx LLAMA_CACHE "$HOME/Projects/llama.cpp/unsloth/gemma-4-26b-A4B-it-GGUF"

"$HOME/Projects/llama.cpp/build/bin/llama-server" \
    -hf unsloth/gemma-4-26b-A4B-it-GGUF:UD-Q4_K_M \
    --ctx-size "$ctx_size" \
    --temp 1.0 \
    --top-p 0.95 \
    --top-k 20 \
    --min-p 0.00 \
    --host 0.0.0.0 --port "$port" \
    --flash-attn on \
    --alias gemma-4-26b --jinja
